---
title: Online shop
---
erDiagram
    CUSTOMER ||--o{ ORDER : places
    CUSTOMER ||--o{ ADDRESS : "ships to"
    ORDER ||--|{ LINE_ITEM : contains
    PRODUCT ||--o{ LINE_ITEM : "ordered in"
    PRODUCT }o..o{ CATEGORY : "belongs to"
    CUSTOMER {
        uuid id PK
        string email UK "login name"
        string name
        timestamp created_at
    }
    ORDER {
        uuid id PK
        uuid customer_id FK
        decimal total
        string status "pending, paid, shipped"
    }
    LINE_ITEM {
        uuid order_id PK, FK
        uuid product_id PK, FK
        int quantity
    }
    PRODUCT["Product catalog"] {
        uuid id PK
        string sku UK
        string title
        decimal price
    }
    CATEGORY
    ADDRESS
