---
title: Order processing
---
stateDiagram-v2
    direction TB
    state if_stock <<choice>>
    [*] --> Received
    Received : New order received
    Received --> Validating : submit

    state Validating {
        direction LR
        [*] --> CheckItems
        CheckItems --> CheckInventory : items ok
        CheckInventory --> [*]
    }
    Validating --> if_stock
    if_stock --> OutOfStock : insufficient
    if_stock --> Fulfilment : available
    OutOfStock : Notify customer
    OutOfStock --> [*]

    state Fulfilment {
        state fork_state <<fork>>
        state join_state <<join>>
        [*] --> fork_state
        fork_state --> Payment
        fork_state --> Shipping
        state Payment {
            [*] --> Authorize
            Authorize --> Capture : authorized
            Capture --> [*]
        }
        state Shipping {
            [*] --> Pick
            Pick --> Pack
            Pack --> [*]
        }
        Payment --> join_state
        Shipping --> join_state
        join_state --> [*]
    }
    Fulfilment --> Completed
    Completed --> [*]

    note right of OutOfStock : Customer can retry later
    note left of Fulfilment
        Payment and shipping
        run in parallel
    end note
