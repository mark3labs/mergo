flowchart TD
    start((Start)) --> login[/User enters credentials/]
    login --> valid{Valid?}
    valid -- No --> attempts{"Attempts < 3?"}
    attempts -- Yes --> login
    attempts -- No --> locked[Account locked]:::danger
    valid -- Yes --> mfa{MFA enabled?}
    mfa -- Yes --> code[/Enter OTP code/] --> verify{Code OK?}
    verify -- No --> code
    verify -- Yes --> session
    mfa -- No --> session[Create session]
    session --> done(((Signed in)))
    locked --> done2((End))
    classDef danger fill:#fdecea,stroke:#d93025,color:#8c1d18
    style done fill:#e6f4ea,stroke:#1e8e3e
